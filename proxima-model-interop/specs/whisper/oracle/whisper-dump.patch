+// PROXNUM-610 S0 oracle dump hook: when WHISPER_DUMP_DIR is set, write the
+// named tensor as raw little-endian f32. Out-of-tree build only; never used
+// by the reference timings.
+static void whisper_dump_raw(const char * name, const void * data, size_t nbytes) {
+    const char * dir = getenv("WHISPER_DUMP_DIR");
+    if (dir == nullptr || dir[0] == '\0' || data == nullptr) {
+        return;
+    }
+    const std::string path = std::string(dir) + "/" + name;
+    FILE * file = fopen(path.c_str(), "wb");
+    if (file == nullptr) {
+        return;
+    }
+    fwrite(data, 1, nbytes, file);
+    fclose(file);
+}
