
static inline uint probe(float value) {
    float scaled = value * 1e0f;
    float rounded = (as_type<uint>(value) & 0x7fffffffu) > 0x7f800000u ? 0.0f : rint(scaled);
    float extent = fabs(rounded);
    uint magnitude = extent > 127.0f ? 0x7fu : (uint)min(extent, 127.0f);
    return magnitude | ((as_type<uint>(value) & 0x7fffffffu) > 0x7f800000u ? 0u : ((as_type<uint>(scaled) >> 31u) << 7u));
}
