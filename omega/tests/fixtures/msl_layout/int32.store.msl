
static inline uint probe(float value) {
    float scaled = value * 1e0f;
    float rounded = (as_type<uint>(value) & 0x7fffffffu) > 0x7f800000u ? 0.0f : rint(scaled);
    int clamped = (int)clamp(rounded, -2147483648.0f, 2147483520.0f);
    return rounded > 2147483520.0f ? 0x7fffffffu : ((uint)clamped & 0xffffffffu);
}
