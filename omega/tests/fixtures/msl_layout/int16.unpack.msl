
static inline float probe_value(uint code) {
    uint mantissa = code & 0x7fffu;
    return ((float)((int)mantissa - (int)(((code >> 15u) & 1u) << 15u))) * 1e0f;
}

static inline float probe(device const uchar *payload, uint index) {
    uint offset = index * 2u;
    uint code = ((uint)payload[offset + 0u] << 0u) | ((uint)payload[offset + 1u] << 8u);
    return probe_value(code);
}
