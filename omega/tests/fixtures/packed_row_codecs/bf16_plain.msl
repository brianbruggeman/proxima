}
static inline float uniform_expert_element_from_offset_q5k(
        device const uchar *payload,
        device const ExpertPayloadDescriptor *descriptor,
        uint expert,
        long full_offset,
        long expert_stride) {
    long local = full_offset - (long)expert * expert_stride;
    device const uchar *block = payload + descriptor[expert].byte_offset +
        (uint)(local / 256l) * 176u;
    return q5k_element(block, (uint)(local % 256l));
}
static inline float uniform_expert_element_from_offset_q6k(
        device const uchar *payload,
        device const ExpertPayloadDescriptor *descriptor,
        uint expert,
        long full_offset,
        long expert_stride) {
    long local = full_offset - (long)expert * expert_stride;
    device const uchar *block = payload + descriptor[expert].byte_offset +
        (uint)(local / 256l) * 210u;
    return q6k_element(block, (uint)(local % 256l));
}


static inline float q8_0_field(uint code) {
    uint mantissa = code & 0x7fu;
    return ((float)((int)mantissa - (int)(((code >> 7u) & 1u) << 7u))) * 1e0f;
}

static inline uint q8_0_group(device const uchar *group) {
    return ((uint)group[0] << 0u);
}

static inline float q8_0_element(device const uchar *block, uint index) {
    ushort scale_bits = (ushort)((uint)block[0] | ((uint)block[1] << 8));
    float scale = (float)as_type<half>(scale_bits);
    uint word = q8_0_group(block + 2u + (index / 1u) * 1u);
    uint field = (word >> ((index % 1u) * 8u)) & 0xffu;
    return q8_0_field(field) * scale;
}

static inline float q8_0_super_element(device const uchar *superblock, uint index) {
    return q8_0_element(superblock + (index / 32u) * 34u, index % 32u);
}


static inline float q4_0_element_code(uint code) {
    uint mantissa = code & 0xfu;
    return ((float)mantissa) * 1e0f;
}

static inline float q4_0_element_scale(uint code) {
    return (float)as_type<half>((ushort)code);
}

static inline float q4_0_element(device const uchar *block, uint index) {
    uint raw_low_rest = index;
    uint raw_low_address = 16u;
    raw_low_address += (raw_low_rest % 16u) * 8u;
    raw_low_rest /= 16u;
    raw_low_address += (raw_low_rest % 2u) * 4u;
    raw_low_rest /= 2u;
    uint raw_low = ((uint)block[raw_low_address / 8u] >> (raw_low_address % 8u)) & 0xfu;
    float raw = q4_0_element_code(raw_low);
    float scale = q4_0_element_scale(((uint)block[0u] << 0u) | ((uint)block[1u] << 8u));
    float value = ((1.0f * raw) - 8.0f) * scale;
    return value;
}


static inline float q4_0_super_element(device const uchar *superblock, uint index) {
    return q4_0_element(superblock + (index / 32u) * 18u, index % 32u);
}


static inline float q4_0_pair_dot(device const uchar *superblock, uint slot, thread const float *acts) {
    device const uchar *block = superblock + (slot / 32u) * 18u;
    ushort d_bits = (ushort)((uint)block[0] | ((uint)block[1] << 8));
    float d = (float)as_type<half>(d_bits);
    device const uchar *qs = block + 2;
    float result = 0.0f;
    for (uint j = 0u; j < 16u; ++j) {
        uchar byte = qs[j];
        float low = (float)((int)(byte & 0x0Fu) - 8);
        float high = (float)((int)(byte >> 4u) - 8);
        result += d * low * acts[j];
        result += d * high * acts[j + 16u];
    }
    return result;
}


static inline float q4_0_block_scale(device const uchar *block) {
    ushort d_bits = (ushort)((uint)block[0] | ((uint)block[1] << 8));
    return (float)as_type<half>(d_bits);
}

static inline void q4_0_run8(device const uchar *block, uint index, thread float *out) {
    device const uchar *qs = block + 2;
    uint shift = (index < 16u) ? 0u : 4u;
    uint base = index % 16u;
    for (uint j = 0u; j < 8u; ++j) {
        uchar byte = qs[base + j];
        out[j] = (float)((byte >> shift) & 0x0Fu);
    }
}


static inline float q5_1_element_code(uint code) {
    uint mantissa = code & 0x1fu;
    return ((float)mantissa) * 1e0f;
}

static inline float q5_1_element_scale(uint code) {
    return (float)as_type<half>((ushort)code);
}

static inline float q5_1_element_min(uint code) {
    return (float)as_type<half>((ushort)code);
}

static inline float q5_1_element(device const uchar *block, uint index) {
    uint raw_low_rest = index;
    uint raw_low_address = 64u;
    raw_low_address += (raw_low_rest % 16u) * 8u;
    raw_low_rest /= 16u;
    raw_low_address += (raw_low_rest % 2u) * 4u;
    raw_low_rest /= 2u;
    uint raw_low = ((uint)block[raw_low_address / 8u] >> (raw_low_address % 8u)) & 0xfu;
    uint raw_high_rest = index;
    uint raw_high_address = 32u;
    raw_high_address += (raw_high_rest % 32u) * 1u;
    raw_high_rest /= 32u;
    uint raw_high = ((uint)block[raw_high_address / 8u] >> (raw_high_address % 8u)) & 0x1u;
    float raw = q5_1_element_code((raw_low | (raw_high << 4u)));
    float scale = q5_1_element_scale(((uint)block[0u] << 0u) | ((uint)block[1u] << 8u));
    float value = ((1.0f * raw) - 0.0f) * scale;
    float minimum = q5_1_element_min(((uint)block[2u] << 0u) | ((uint)block[3u] << 8u));
    value = value + (1.0f * minimum);
    return value;
}


static inline float q5_0_element_code(uint code) {
    uint mantissa = code & 0x1fu;
    return ((float)mantissa) * 1e0f;
}

static inline float q5_0_element_scale(uint code) {
    return (float)as_type<half>((ushort)code);
}

static inline float q5_0_element(device const uchar *block, uint index) {
    uint raw_low_rest = index;
    uint raw_low_address = 48u;
    raw_low_address += (raw_low_rest % 16u) * 8u;
    raw_low_rest /= 16u;
    raw_low_address += (raw_low_rest % 2u) * 4u;
    raw_low_rest /= 2u;
    uint raw_low = ((uint)block[raw_low_address / 8u] >> (raw_low_address % 8u)) & 0xfu;
    uint raw_high_rest = index;
    uint raw_high_address = 16u;
    raw_high_address += (raw_high_rest % 32u) * 1u;
    raw_high_rest /= 32u;
    uint raw_high = ((uint)block[raw_high_address / 8u] >> (raw_high_address % 8u)) & 0x1u;
    float raw = q5_0_element_code((raw_low | (raw_high << 4u)));
    float scale = q5_0_element_scale(((uint)block[0u] << 0u) | ((uint)block[1u] << 8u));
    float value = ((1.0f * raw) - 16.0f) * scale;
    return value;
}


static inline float bf16_element_value(uint code) {
    return (float)as_type<bfloat>((ushort)code);
}

static inline float bf16_element(device const uchar *payload, uint index) {
    uint offset = index * 2u;
    uint code = ((uint)payload[offset + 0u] << 0u) | ((uint)payload[offset + 1u] << 8u);
    return bf16_element_value(code);
}


static inline uint bf8_e5m2_element_value_scaled_bits(uint significand, int scale) {
    if (significand == 0u) {
        return 0u;
    }
    int lead = 31 - (int)clz(significand);
    int biased = lead + scale + 127;
    if (biased >= 255) {
        return 0x7f800000u;
    }
    if (biased >= 1) {
        return ((uint)biased << 23u) | ((significand << (uint)(23 - lead)) & 0x7fffffu);
    }
    int shift = scale + 149;
    if (shift >= 0) {
        return significand << (uint)shift;
    }
    return -shift >= 32 ? 0u : significand >> (uint)(-shift);
}

static inline float bf8_e5m2_element_value(uint code) {
    uint mantissa = code & 0x3u;
    uint exponent = (code >> 2u) & 0x1fu;
    uint sign = ((code >> 7u) & 1u) << 31u;
    if (exponent == 0x1fu) {
        return as_type<float>(sign | 0x7f800000u | (mantissa == 0u ? 0u : (0x400000u | (mantissa << 21u))));
    }
    uint significand = exponent == 0u ? mantissa : (0x4u | mantissa);
    int scale = exponent == 0u ? (1 - (15) - 2) : ((int)exponent - (15) - 2);
    return as_type<float>(sign | bf8_e5m2_element_value_scaled_bits(significand, scale));
}

static inline float bf8_e5m2_element(device const uchar *payload, uint index) {
    uint offset = index * 1u;
    uint code = ((uint)payload[offset + 0u] << 0u);
    return bf8_e5m2_element_value(code);
}


static inline uint bf4_e2m1_element_value_scaled_bits(uint significand, int scale) {
    if (significand == 0u) {
        return 0u;
    }
    int lead = 31 - (int)clz(significand);
    int biased = lead + scale + 127;
    if (biased >= 255) {
        return 0x7f800000u;
    }
    if (biased >= 1) {
        return ((uint)biased << 23u) | ((significand << (uint)(23 - lead)) & 0x7fffffu);
    }
    int shift = scale + 149;
    if (shift >= 0) {
        return significand << (uint)shift;
    }
    return -shift >= 32 ? 0u : significand >> (uint)(-shift);
}

static inline float bf4_e2m1_element_value(uint code) {
    uint mantissa = code & 0x1u;
    uint exponent = (code >> 1u) & 0x3u;
    uint sign = ((code >> 3u) & 1u) << 31u;
    uint significand = exponent == 0u ? mantissa : (0x2u | mantissa);
    int scale = exponent == 0u ? (1 - (1) - 1) : ((int)exponent - (1) - 1);
    return as_type<float>(sign | bf4_e2m1_element_value_scaled_bits(significand, scale));
}

static inline float bf4_e2m1_element(device const uchar *payload, uint index) {
    uint bit = index * 4u;
    uint code = ((uint)payload[bit / 8u] >> (bit % 8u)) & 0xfu;
    return bf4_e2m1_element_value(code);
}

struct Uniforms {
    long output_total;
    long reduction_total;
    long output_extents[2];
    long reduction_extents[1];
    long operand_base[2];
    long operand_strides[2][3];
    long out_base;
    long out_strides[3];
};

kernel void omega_reduce_r3_o2_n2_multiply_add_zero(
    device const uchar* in0 [[buffer(0)]],
    device const float* in1 [[buffer(1)]],
    device float* out [[buffer(2)]],
    constant Uniforms& u [[buffer(3)]],
    uint gid [[thread_position_in_grid]])
{
    long output_index = (long)gid / 64;
    uint sgitg = (gid / 32u) % 2u;
    uint lane = gid % 32u;
    long group_first = output_index * 2;
    float sumf[2];
    for (int q = 0; q < 2; ++q) { sumf[q] = 0.0f; }
    long weight_base[2];
    long other_base[2];
    long coord_q_cache[2][3];
    long weight_row_stride = u.operand_strides[0][1];
    long other_row_stride = u.operand_strides[1][1];
    for (int q = 0; q < 2; ++q) {
        long flat = group_first + q;
        for (int d = 0; d < 3; ++d) { coord_q_cache[q][d] = 0; }
        coord_q_cache[q][1] = flat;
        weight_base[q] = u.operand_base[0] + flat * weight_row_stride;
        other_base[q] = u.operand_base[1] + flat * other_row_stride;
    }
    long other_stride = u.operand_strides[1][2];
    int blocks = (int)u.reduction_total / 8;
    int ib_first = (int)(lane + sgitg * 32u);
    int ib_step = 64;
    long blk_step = (long)ib_step * 8;
    device const bfloat *blk_ptr[2];
    for (int q = 0; q < 2; ++q) {
        blk_ptr[q] = (device const bfloat *)in0 + (long)weight_base[q] + (long)ib_first * 8;
    }
    float acts[8];
    long acts_step = (long)ib_step * 8;
    device const float *acts_row = in1 + other_base[0] + (long)ib_first * 8;
    for (int ib = ib_first; ib < blocks; ib += ib_step) {
        for (int j = 0; j < 8; ++j) {
            acts[j] = acts_row[j];
        }
        for (int q = 0; q < 2; ++q) {
            device const bfloat *blk = blk_ptr[q];
            float result = 0.0f;
            for (uint j = 0u; j < 8u; ++j) {
                result += (float)blk[j] * acts[j];
            }
            sumf[q] = sumf[q] + result;
        }
        for (int q = 0; q < 2; ++q) { blk_ptr[q] += blk_step; }
        acts_row += acts_step;
    }
    threadgroup float partial_sums[2][2];
    for (int q = 0; q < 2; ++q) {
        float reduced = simd_sum(sumf[q]);
        if (lane == 0u) { partial_sums[sgitg][q] = reduced; }
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (sgitg == 0u && lane == 0u) {
        for (int q = 0; q < 2; ++q) {
            float total = partial_sums[0][q];
            for (uint s = 1u; s < 2u; ++s) {
                total = (total + partial_sums[s][q]);
            }
            long flat = group_first + q;
            if (flat < u.output_total) {
                long out_offset = u.out_base;
                out_offset += coord_q_cache[q][0] * u.out_strides[0];
                out_offset += coord_q_cache[q][1] * u.out_strides[1];
                out_offset += coord_q_cache[q][2] * u.out_strides[2];
                out[out_offset] = total;
            }
        }
    }
}
