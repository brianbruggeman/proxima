//// merge
struct Uniforms { long total_elements; long splits; };

kernel void omega_cached_attention_q1_h1_g8_d256_s3f800000_ln511_up0_x4_e1_k1_ds_merge(device const float* in0 [[buffer(0)]], device float* out [[buffer(1)]], constant Uniforms& u [[buffer(2)]], uint tg [[threadgroup_position_in_grid]], ushort lane [[thread_index_in_simdgroup]], ushort simdgroup_slot [[simdgroup_index_in_threadgroup]], ushort simdgroup_count [[simdgroups_per_threadgroup]]) {
    if ((long)tg >= u.total_elements) { return; }
    constexpr long head_dim = 256;
    long splits = u.splits;
    device const float* stats = in0 + u.total_elements * head_dim * splits;
    bool live = (long)lane < splits;
    float own_max = live ? stats[((long)tg * splits + (long)lane) * 2L] : -INFINITY;
    float own_sum = live ? stats[((long)tg * splits + (long)lane) * 2L + 1L] : 0.0f;
    float global_max = simd_max(own_max);
    float weight = (own_max == -INFINITY) ? 0.0f : exp(own_max - global_max);
    float total = simd_sum(own_sum * weight);
    float inverse = (total == 0.0f) ? 0.0f : 1.0f / total;
    device const float4* partial4 = (device const float4*)in0 + (long)tg * (head_dim / 4L) * splits;
    device float* out_row = out + (long)tg * head_dim;
    for (long dim4 = (long)simdgroup_slot; dim4 < head_dim / 4L; dim4 += (long)simdgroup_count) {
        float4 summed = simd_sum(live ? partial4[dim4 * splits + (long)lane] * weight : float4(0.0f));
        if (lane == 0) {
            out_row[dim4 * 4L] = (float)(summed.x * inverse);
            out_row[dim4 * 4L + 1L] = (float)(summed.y * inverse);
            out_row[dim4 * 4L + 2L] = (float)(summed.z * inverse);
            out_row[dim4 * 4L + 3L] = (float)(summed.w * inverse);
        }
    }
}
