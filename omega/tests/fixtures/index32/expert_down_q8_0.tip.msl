struct Uniforms {
    long output_total;
    long reduction_total;
    long output_extents[3];
    long reduction_extents[1];
    long operand_base[2];
    long operand_strides[2][4];
    long out_base;
    long out_strides[4];
    long gather_index_base[1];
    long gather_index_strides[1][4];
    long gather_element_stride[1];
    long gather_extent[1];
};

kernel void omega_reduce_r4_o3_n2_multiply_add_zero_g10(
    device const uchar* in0 [[buffer(0)]],
    device const float* in1 [[buffer(1)]],
    device const float* gather_idx0 [[buffer(2)]],
    device float* out [[buffer(3)]],
    constant Uniforms& u [[buffer(4)]],
    device atomic_uint* fault [[buffer(5)]],
    uint gid [[thread_position_in_grid]])
{
    long output_index = (long)gid / 32;
    uint lane = gid % 32u;
    long group_first = output_index * 4;
    float sumf[4];
    for (int q = 0; q < 4; ++q) { sumf[q] = 0.0f; }
    long weight_base[4];
    long other_base[4];
    long coord_q_cache[4][4];
    long weight_selected_stride = u.operand_strides[0][1];
    long weight_out_stride = u.operand_strides[0][3];
    long other_selected_stride = u.operand_strides[1][1];
    long other_out_stride = u.operand_strides[1][3];
    long group_out_extent = u.output_extents[2];
    long expert_slot = (long)((uint)group_first / (uint)group_out_extent);
    long out_row_base = (long)((uint)group_first % (uint)group_out_extent);
    for (int q = 0; q < 4; ++q) {
        for (int d = 0; d < 4; ++d) { coord_q_cache[q][d] = 0; }
        long out_row = out_row_base + q;
        coord_q_cache[q][1] = expert_slot;
        coord_q_cache[q][3] = out_row;
        weight_base[q] = u.operand_base[0] + expert_slot * weight_selected_stride + out_row * weight_out_stride;
        other_base[q] = u.operand_base[1] + expert_slot * other_selected_stride + out_row * other_out_stride;
    long gather_off0 = u.gather_index_base[0];
    gather_off0 += coord_q_cache[q][0] * u.gather_index_strides[0][0];
    gather_off0 += coord_q_cache[q][1] * u.gather_index_strides[0][1];
    gather_off0 += coord_q_cache[q][2] * u.gather_index_strides[0][2];
    gather_off0 += coord_q_cache[q][3] * u.gather_index_strides[0][3];
    long fetched0 = (long)gather_idx0[gather_off0];
    if (lane == 0u) {
    if (fetched0 < 0 || fetched0 >= u.gather_extent[0]) {
        atomic_fetch_max_explicit(&fault[0], (uint)max(fetched0, (long)0) + 1u, memory_order_relaxed);
    }
    }
    fetched0 = max((long)0, min(fetched0, u.gather_extent[0] - 1));
    fetched0 = (long)simd_broadcast_first((uint)fetched0);
    weight_base[q] += fetched0 * u.gather_element_stride[0];
    }
    long other_stride = u.operand_strides[1][2];
    uint ix = (uint)lane / 8u;
    uint it = (uint)lane % 8u;
    uint slot = it * 32u;
    float acts[32];
    int super_blocks = (int)u.reduction_total / 256;
    int ib_first = (int)ix;
    int ib_step = 4;
    long blk_step = (long)ib_step * 272;
    device const uchar *blk_ptr[4];
    for (int q = 0; q < 4; ++q) {
        blk_ptr[q] = in0 + ((long)((int)weight_base[q] / 256) + (long)ib_first) * 272;
    }
    long acts_step = (long)ib_step * 256;
    device const float *acts_row = in1 + other_base[0] + (long)ib_first * 256 + (long)slot;
    for (int ib = ib_first; ib < super_blocks; ib += ib_step) {
        for (int j = 0; j < 32; ++j) {
            acts[j] = acts_row[j];
        }
        for (int q = 0; q < 4; ++q) {
            device const uchar *blk = blk_ptr[q];
            sumf[q] = sumf[q] + q8_0_pair_dot(blk, slot, acts);
        }
        for (int q = 0; q < 4; ++q) { blk_ptr[q] += blk_step; }
        acts_row += acts_step;
    }
    float reduced_row0 = simd_sum(sumf[0]);
    float reduced_row1 = simd_sum(sumf[1]);
    float reduced_row2 = simd_sum(sumf[2]);
    float reduced_row3 = simd_sum(sumf[3]);
    if (lane < 4u) {
        float reduced = (lane == 0u ? reduced_row0 : (lane == 1u ? reduced_row1 : (lane == 2u ? reduced_row2 : reduced_row3)));
        long flat = group_first + (long)lane;
        if (flat < u.output_total) {
            long lane_coord[4];
            lane_coord[0] = (lane == 0u ? coord_q_cache[0][0] : (lane == 1u ? coord_q_cache[1][0] : (lane == 2u ? coord_q_cache[2][0] : coord_q_cache[3][0])));
            lane_coord[1] = (lane == 0u ? coord_q_cache[0][1] : (lane == 1u ? coord_q_cache[1][1] : (lane == 2u ? coord_q_cache[2][1] : coord_q_cache[3][1])));
            lane_coord[2] = (lane == 0u ? coord_q_cache[0][2] : (lane == 1u ? coord_q_cache[1][2] : (lane == 2u ? coord_q_cache[2][2] : coord_q_cache[3][2])));
            lane_coord[3] = (lane == 0u ? coord_q_cache[0][3] : (lane == 1u ? coord_q_cache[1][3] : (lane == 2u ? coord_q_cache[2][3] : coord_q_cache[3][3])));
            long out_offset = u.out_base;
            out_offset += lane_coord[0] * u.out_strides[0];
            out_offset += lane_coord[1] * u.out_strides[1];
            out_offset += lane_coord[2] * u.out_strides[2];
            out_offset += lane_coord[3] * u.out_strides[3];
            out[out_offset] = reduced;
        }
    }
}
