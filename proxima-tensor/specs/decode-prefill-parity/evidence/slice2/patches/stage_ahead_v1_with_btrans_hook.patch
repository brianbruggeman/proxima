+/// `PROXIMA_TILED_GEMM_STAGE_AHEAD`'s register file: one `half` array per
+/// unit holding the decoded half-block between the global read and the
+/// threadgroup store, declared once before the `k0` loop.
+#[cfg(feature = "metal-tiled-gemm")]
+fn push_stage_ahead_weight_registers(source: &mut String, half_units: u64, half_width: u64) {
+    for unit in 0..half_units {
+        source.push_str(&format!("    half wws_vals{unit}[{half_width}];\n"));
+    }
+}
+
+/// Stage-ahead's load half, emitted BEFORE the barrier that fences the
+/// previous K-step's multiplies: the same global reads and decode as
+/// [`push_wide_weight_stage_body`], but each decoded value lands in
+/// `wws_valsN` instead of `weight_tile`, so the reads are in flight while the
+/// slowest simdgroup finishes its multiplies. The pointer advance happens
+/// here because the decode is the last reader of `wws_blk`/`wws_slot`.
+#[cfg(feature = "metal-tiled-gemm")]
+#[allow(clippy::too_many_arguments)]
+fn push_stage_ahead_weight_loads(
+    source: &mut String,
+    codec: Codec,
+    block_k: u64,
+    num_chunks: u64,
+    half_width: u64,
+    half_units: u64,
+    chunk_width: u64,
+    block_elements: u64,
+    block_bytes: u64,
+) {
+    let runs = half_width / 8;
+    for unit in 0..half_units {
+        source.push_str(&format!("        if (wws_active{unit}) {{\n"));
+        match codec {
+            Codec::Q4_0 => {
+                source.push_str(&format!(
+                    "            float q4_0_d = q4_0_block_scale(wws_blk{unit});\n"
+                ));
+                for run_index in 0..runs {
+                    let run_offset = run_index * 8;
+                    source.push_str("            {\n");
+                    source.push_str("                float levels[8];\n");
+                    source.push_str(&format!(
+                        "                q4_0_run8_wide(wws_blk{unit}, wws_slot{unit} + {run_offset}u, levels);\n"
+                    ));
+                    source.push_str(&format!(
+                        "                for (int j = 0; j < 8; ++j) {{ wws_vals{unit}[{run_offset} + j] = (half)((levels[j] - 8.0f) * q4_0_d); }}\n"
+                    ));
+                    source.push_str("            }\n");
+                }
+            }
+            _ => {
+                source.push_str(&format!(
+                    "            q4k_header wws_hdr{unit} = q4k_header_for(wws_blk{unit}, wws_slot{unit});\n"
+                ));
+                for run_index in 0..runs {
+                    let run_offset = run_index * 8;
+                    source.push_str("            {\n");
+                    source.push_str("                float levels[8];\n");
+                    source.push_str(&format!(
+                        "                q4k_run8(wws_blk{unit}, wws_slot{unit} + {run_offset}u, levels);\n"
+                    ));
+                    source.push_str(&format!(
+                        "                for (int j = 0; j < 8; ++j) {{ wws_vals{unit}[{run_offset} + j] = (half)(wws_hdr{unit}.scale * levels[j] - wws_hdr{unit}.minimum); }}\n"
+                    ));
+                    source.push_str("            }\n");
+                }
+            }
+        }
+        push_wide_weight_stage_advance(
+            source,
+            unit,
+            block_k,
+            num_chunks,
+            chunk_width,
+            block_elements,
+            block_bytes,
+        );
+        source.push_str("        }\n");
+    }
+}
+
+/// Stage-ahead's store half, emitted AFTER the barrier: `half4` stores of the
+/// registers [`push_stage_ahead_weight_loads`] filled, at the same
+/// `weight_tile` offsets [`push_wide_weight_stage_half4_store`] writes.
+#[cfg(feature = "metal-tiled-gemm")]
+fn push_stage_ahead_weight_stores(
+    source: &mut String,
+    block_k: u64,
+    half_width: u64,
+    half_units: u64,
+) {
+    for unit in 0..half_units {
+        source.push_str(&format!("        if (wws_active{unit}) {{\n"));
+        for group in 0..half_width / 4 {
+            let base = group * 4;
+            let target = format!("wws_row{unit} * {block_k} + wws_koff{unit} + {base}");
+            source.push_str(&format!(
+                "            *(threadgroup half4 *)&weight_tile[{target}] = half4(wws_vals{unit}[{base}], wws_vals{unit}[{}], wws_vals{unit}[{}], wws_vals{unit}[{}]);\n",
+                base + 1,
+                base + 2,
+                base + 3,
+            ));
+        }
+        source.push_str("        }\n");
+    }
+}
+
+/// Stage-ahead's activation registers: the interior-tile flag, loop invariant
+/// so declared once, and one `float4` per vector this thread owns.
+#[cfg(feature = "metal-tiled-gemm")]
+fn push_stage_ahead_activation_registers(source: &mut String, block_n: u64, iterations: u64) {
+    source.push_str(&format!(
+        "    bool act_tile_interior = (col_tile * {block_n} + {block_n} <= token_extent);\n"
+    ));
+    source.push_str(&format!("    float4 act_wide[{iterations}];\n"));
+}
+
+/// Stage-ahead's activation load half, before the barrier: the interior
+/// tile's `float4` reads of [`push_tiled_gemm_body`]'s wide activation load,
+/// held in `act_wide` instead of stored. `flat = idx4 * 4` stays a multiple of
+/// four, so a vector never straddles a token row (`block_k % 4 == 0`).
+#[cfg(feature = "metal-tiled-gemm")]
+#[allow(clippy::too_many_arguments)]
+fn push_stage_ahead_activation_loads(
+    source: &mut String,
+    other: usize,
+    token_axis: u16,
+    reduce_dim: usize,
+    block_k: u64,
+    block_n: u64,
+    vector_count: u64,
+    iterations: u64,
+    block_threads: u64,
+) {
+    source.push_str("        if (act_tile_interior) {\n");
+    for iteration in 0..iterations {
+        let offset = iteration * block_threads;
+        source.push_str("            {\n");
+        source.push_str(&format!("                long idx4 = tiitg + {offset};\n"));
+        source.push_str(&format!("                if (idx4 < {vector_count}) {{\n"));
+        source.push_str("                    long flat = idx4 * 4;\n");
+        source.push_str(&format!("                    long a_col = flat / {block_k};\n"));
+        source.push_str(&format!("                    long a_k = flat % {block_k};\n"));
+        source.push_str(&format!(
+            "                    long a_tok = col_tile * {block_n} + a_col;\n"
+        ));
+        source.push_str("                    long a_k_global = k0 + a_k;\n");
+        source.push_str(&format!(
+            "                    long aoff = u.operand_base[{other}] + a_tok * u.operand_strides[{other}][{token_axis}] + a_k_global * u.operand_strides[{other}][{reduce_dim}];\n"
+        ));
+        source.push_str(&format!(
+            "                    act_wide[{iteration}] = *(const device float4 *)(in{other} + aoff);\n"
+        ));
+        source.push_str("                }\n");
+        source.push_str("            }\n");
+    }
+    source.push_str("        }\n");
+}
+
+/// Stage-ahead's activation store half, after the barrier: the four lanes of
+/// each held `float4` into `act_tile` at the offsets the direct wide load
+/// writes.
+#[cfg(feature = "metal-tiled-gemm")]
+fn push_stage_ahead_activation_stores(
+    source: &mut String,
+    block_k: u64,
+    vector_count: u64,
+    iterations: u64,
+    block_threads: u64,
+) {
+    for iteration in 0..iterations {
+        let offset = iteration * block_threads;
+        source.push_str("            {\n");
+        source.push_str(&format!("                long idx4 = tiitg + {offset};\n"));
+        source.push_str(&format!("                if (idx4 < {vector_count}) {{\n"));
+        source.push_str("                    long flat = idx4 * 4;\n");
+        source.push_str(&format!("                    long a_col = flat / {block_k};\n"));
+        source.push_str(&format!("                    long a_k = flat % {block_k};\n"));
+        for (lane, component) in ["x", "y", "z", "w"].into_iter().enumerate() {
+            let suffix = if lane == 0 {
+                String::new()
+            } else {
+                format!(" + {lane}")
+            };
+            source.push_str(&format!(
+                "                    act_tile[a_col * {block_k} + a_k{suffix}] = act_wide[{iteration}].{component};\n"
+            ));
+        }
+        source.push_str("                }\n");
+        source.push_str("            }\n");
+    }
+}
