+/// Pops the smallest retired slot whose byte length is at least `request_bytes`,
+/// so a buffer retired by one size class serves a later, smaller request
+/// instead of staying idle while that request allocates. The consumer binds
+/// the slot at offset 0 and reads only its own element count, so a longer
+/// slot is a whole-buffer reuse like an exact fit. A node the caller reads
+/// back (`exact_only`) keeps the exact-length rule, since `finish` hands its
+/// buffer out as the node's value.
+#[cfg(feature = "metal-plan-stable-buffers")]
+fn take_free_slot(
+    free_by_size: &mut BTreeMap<usize, Vec<usize>>,
+    request_bytes: usize,
+    exact_only: bool,
+) -> Option<usize> {
+    let ratio: usize = std::env::var("EXPERIMENT_FIT_RATIO").ok().and_then(|value| value.parse().ok()).unwrap_or(1);
+    let longest = if exact_only { request_bytes } else { request_bytes.saturating_mul(ratio) };
+    let size = free_by_size
+        .range(request_bytes..=longest)
+        .find_map(|(size, slots)| (!slots.is_empty()).then_some(*size))?;
+    free_by_size.get_mut(&size).and_then(Vec::pop)
+}
