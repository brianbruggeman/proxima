+/// Replays the arena's own slot assignment and retirement to report, per slot
+/// byte length: how many physical slots the plan holds, the most of them live
+/// at once, and which op kinds (with extents) wrote into the class. A class
+/// whose `held_bytes` exceeds `peak_live_bytes` is slots kept past their use.
+#[cfg(all(feature = "metal-plan-stable-buffers", feature = "instrument"))]
+fn emit_arena_class_census(
+    resolved: &[BoundOp],
+    retires: &[Vec<NodeId>],
+    position_slot: &[Option<usize>],
+    position_extras: &[core::ops::Range<usize>],
+    extra_slots: &[(NodeId, usize)],
+    slot_bytes: &[usize],
+) {
+    let mut slots_in_class: BTreeMap<usize, usize> = BTreeMap::new();
+    for bytes in slot_bytes {
+        *slots_in_class.entry(*bytes).or_default() += 1;
+    }
+    let mut live_nodes: BTreeMap<NodeId, usize> = BTreeMap::new();
+    let mut live: BTreeMap<usize, usize> = BTreeMap::new();
+    let mut peak_live: BTreeMap<usize, usize> = BTreeMap::new();
+    let mut writers: BTreeMap<usize, BTreeMap<String, usize>> = BTreeMap::new();
+    for (position, bound) in resolved.iter().enumerate() {
+        let primary = position_slot[position].map(|slot| (bound.node, slot_bytes[slot]));
+        let extras = extra_slots[position_extras[position].clone()]
+            .iter()
+            .map(|(node, slot)| (*node, slot_bytes[*slot]));
+        for (node, class) in primary.into_iter().chain(extras) {
+            live_nodes.insert(node, class);
+            let count = live.entry(class).or_default();
+            *count += 1;
+            let high = peak_live.entry(class).or_default();
+            *high = (*high).max(*count);
+            let label = format!("{}{:?}", bound.kind.name(), bound.extents);
+            *writers.entry(class).or_default().entry(label).or_default() += 1;
+        }
+        for retired in &retires[position] {
+            if let Some(class) = live_nodes.remove(retired) {
+                *live.entry(class).or_default() -= 1;
+            }
+        }
+    }
+    for (class_bytes, slots) in &slots_in_class {
+        let peak = peak_live.get(class_bytes).copied().unwrap_or(0);
+        if class_bytes.saturating_mul(*slots) < (1 << 20) {
+            continue;
+        }
+        debug!(
+            class_bytes = *class_bytes as u64,
+            slots = *slots as u64,
+            peak_live = peak as u64,
+            held_bytes = (class_bytes * slots) as u64,
+            peak_live_bytes = (class_bytes * peak) as u64,
+            writers = ?writers.get(class_bytes),
+            "buffer arena size class"
+        );
+    }
+}
